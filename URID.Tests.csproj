<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Same C# 9 pin as the library: the test sources also compile inside Unity. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>URID.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Same reason as URID.csproj: the project sits at the repo root, so the
         SDK's default glob would pick up every .cs in the repo. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <!-- The same NUnit test sources Unity Test Runner compiles via URID.Tests.asmdef. -->
  <ItemGroup>
    <Compile Include="src\Tests\**\*.cs" LinkBase="Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="URID.csproj" />
  </ItemGroup>

</Project>
